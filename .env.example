# MoneyLens India — environment template. Copy to .env and fill in. NEVER commit .env.
# V1 (GitHub Pages, browser-only) needs NONE of these. They are for the optional V2 server edition.

# Public URL of the deployed app
NEXT_PUBLIC_APP_URL=

# V2: PostgreSQL connection (e.g. Supabase). See database/schema.sql
DATABASE_URL=

# V2: session signing secret (generate: openssl rand -base64 32)
AUTH_SECRET=

# Account Aggregator: "mock" (default) or your licensed AA/TSP integration id
AA_PROVIDER=mock
AA_API_BASE=
AA_CLIENT_ID=
AA_CLIENT_SECRET=

# Optional LLM for free-text questions (assistant still answers only from user data)
AI_API_KEY=

# V2: encrypted object storage bucket for uploaded statements (auto-deleted after parsing)
STORAGE_BUCKET=
